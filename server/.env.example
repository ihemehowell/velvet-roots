# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# A long random string — used to access /api/admin endpoints via the
# x-admin-key header. Generate one with: openssl rand -hex 32
ADMIN_SECRET=change-me-to-something-long-and-random
